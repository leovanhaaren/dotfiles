# Productivity
alias reload="exec zsh"
alias upi="pi update && pi update --extensions"
alias h="herdr"

alias ssh-load-keys="$DOTFILES_DIR/scripts/ssh-load-keys.sh"

# Air (installed via go install)
air() { "$(go env GOPATH)/bin/air" "$@"; }

# Local overrides
[[ -f ~/.aliases.local ]] && source ~/.aliases.local
