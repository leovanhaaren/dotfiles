# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Private keys live in the Proton Pass app's SSH agent (see Host *);
# only tracked public keys select the identity, so a fresh machine
# needs no key files, just an unlocked Proton Pass.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_leovanhaaren.pub
  IdentitiesOnly yes

Host github.com-ksyos
  HostName github.com
  User git
  IdentityFile "~/.ssh/id_leo_ksyos.pub"
  IdentitiesOnly yes

Host 46.225.53.85
  IdentityFile ~/.ssh/id_hetzner

Host mac-mini.local
  HostName leo-mac-mini.stork-duck.ts.net
  User leo
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_leovanhaaren.pub

Host brabonas.local
  HostName brabonas.stork-duck.ts.net
  User leo-admin
  PreferredAuthentications publickey
  PubkeyAuthentication yes

Host docker.local
  HostName brabonas.stork-duck.ts.net
  User docker
  PreferredAuthentications publickey
  PubkeyAuthentication yes

#Host brabonas.local
#  HostName 192.168.1.219
#  User leo-admin
#  PreferredAuthentications password
#  PubkeyAuthentication no
#  PasswordAuthentication yes

# Applies to all hosts; per-host blocks above take precedence.
# known_hosts.base is tracked in the repo so fresh machines get the
# host keys without trust-on-first-use prompts.
# IdentityAgent overrides SSH_AUTH_SOCK, so processes that never read
# .zshrc, such as launchd services and GUI apps, reach the same agent.
Host *
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.base
  IdentityAgent ~/.ssh/proton-pass-ssh-agent.sock
